# SQLite database location. Defaults to ./data/maison.db
# DATA_DIR=/absolute/path/to/maison-data

# Public URL of this deployment. Use the onrender.com URL for preview,
# then switch to the real domain after it is secured.
# SITE_URL=https://maisonduscent-preview.onrender.com

# Public preview mode: disables admin access and sends noindex headers.
# PREVIEW_MODE=true

# Bootstrap admin password used only when the database is first seeded.
# Leave unset locally; set a strong value for any non-preview deployment.
# ADMIN_PASSWORD=replace-with-a-long-random-password
